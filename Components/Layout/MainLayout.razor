@inherits LayoutComponentBase
@inject MyBlazorApp.Components.Services.AuthClient Auth
@inject NavigationManager Nav
@inject MyBlazorApp.Components.State.CurrentUserState UserState
@inject MyBlazorApp.Components.State.BookingState BookingState



<div class="page">

    <!-- TOP NAVBAR / BRANDBAR -->
    <header class="brandbar px-4">
        <div class="brand-left">
            <div class="logo">🏨</div>
            <div>
                <div class="brand-title">Grand Hotel</div>
                <div class="brand-sub">Management System</div>
            </div>
        </div>

        <div class="brand-right">
            @if (UserState.IsLoggedIn)
            {
                <span class="chip">Hello, @UserState.DisplayName</span>
                <button class="chip outline" @onclick="Logout">Logout</button>
            }
            else
            {
                <a class="chip" href="/login">Login</a>
                <a class="chip outline" href="/register">Register</a>
            }
        </div>
    </header>

    <!-- PAGE CONTENT -->
    <main class="content px-4">
        @Body
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task Logout()
    {
        await Auth.LogoutAsync();
        BookingState.ClearAll();
        Nav.NavigateTo("/login", true);
    }

}
