@inherits LayoutComponentBase
@inject MyBlazorApp.Services.AuthService Auth
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg bg-white border-bottom px-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/staff/dashboard">
            <img src="favicon.png" width="30" class="me-2" /> Grand Hotel
        </a>

        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <a class="nav-link" href="/staff/dashboard"><i class="bi bi-grid me-1"></i>Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/staff/rooms"><i class="bi bi-door-closed me-1"></i>Rooms</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/staff/reservations"><i class="bi bi-calendar-check me-1"></i>Reservations</a>
            </li>
        </ul>

        <button class="btn btn-outline-danger" @onclick="Logout">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button>
    </div>
</nav>

<main class="container-fluid mt-3">
    @Body
</main>

@code {
    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/staff/login", true);
    }
}
