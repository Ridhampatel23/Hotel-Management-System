@page "/staff/dashboard"
@layout Components.Layout.StaffLoginLayout
@inject HttpClient Http


<PageTitle>Grand Hotel | Staff Dashboard</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Dashboard</h3>
        <div>
            <button class="btn btn-outline-secondary me-2">Staff View</button>
            <button class="btn btn-dark">
                <i class="bi bi-box-arrow-right me-1"></i> Switch to Guest View
            </button>
        </div>
    </div>

    <p class="text-muted">Welcome to the Hotel Management System</p>

    <div class="card mb-4 p-3 d-flex flex-row align-items-center">
        <img src="favicon.png" width="40" class="me-3" />
        <div>
            <h5 class="mb-0">Grand Hotel</h5>
            <small class="text-muted">Management System</small>
        </div>
    </div>

    @if (isLoading)
    {
        <p class="text-muted">Loading room data...</p>
    }
    else if (errorMessage != null)
    {
        <p class="text-danger">@errorMessage</p>
    }
    else if (rooms != null)
    {
        <div class="row g-3">
            @foreach (var room in rooms)
            {
                <div class="col-md-3">
                    <div class="card shadow-sm p-3">
                        <h6>Room @room.Id</h6>
                        <h5>@room.RoomNumber</h5>
                        <p class="small mb-0 text-muted">@room.RoomType</p>
                        <p class="small mb-0">Status: <strong>@room.Status</strong></p>
                        <p class="small mb-0">Price: $@room.PricePerNight</p>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private List<Room>? rooms;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Call your backend
            rooms = await Http.GetFromJsonAsync<List<Room>>("https://hotel-backend-o5hk.onrender.com/api/Rooms");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class Room
    {
        public int Id { get; set; }
        public string? RoomNumber { get; set; }
        public string? RoomType { get; set; }
        public bool IsAvailable { get; set; }
        public decimal PricePerNight { get; set; }
        public string? Status { get; set; }
    }
}
