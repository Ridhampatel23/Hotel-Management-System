    @code {
    private LoginModel loginModel = new();
    private string errorMessage = "";

    private async Task HandleLogin()
{
    Console.WriteLine("✅ HandleLogin triggered!");

    await Task.Delay(500);

    var fakeUser = new UserModel { Id = 1, Name = "John Smith", Role = "Staff" };
    await Auth.LoginAsync(fakeUser.Role!, fakeUser.Name!);

    Console.WriteLine("✅ Navigating now...");
    Navigation.NavigateTo("/staff/dashboard"        );
}


    // ✅ Models
    public class LoginModel
    {
        public string? Email { get; set; } = string.Empty;
        public string? Password { get; set; } = string.Empty;
    }

    public class UserModel
    {
        public int Id { get; set; }
        public string? Name { get; set; } = string.Empty;
        public string? Role { get; set; } = string.Empty;
    }
}
