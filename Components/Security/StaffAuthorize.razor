@inject MyBlazorApp.Services.AuthService Auth
@inject NavigationManager Navigation

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn || Auth.Role != "staff")
        {
            Navigation.NavigateTo("/staff/login", true);
        }
    }
}

@ChildContent
