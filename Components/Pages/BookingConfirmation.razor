@page "/booking-confirmation"
@rendermode InteractiveServer

@using MyBlazorApp.Components.State
@inject BookingState BookingState
@inject NavigationManager Nav

<PageTitle>Booking Confirmed · Grand Hotel</PageTitle>

<div class="confirm-page">

    @if (!BookingState.HasAnyBookings)
    {
        <section class="card-block">
            <h4>No booking data found</h4>
            <p class="muted">
                Please book a room first, then return to this page.
            </p>

            <div style="margin-top: 1rem; display:flex; gap:.75rem; flex-wrap:wrap;">
                <button class="btn dark" @onclick="@(() => Nav.NavigateTo("/rooms"))">Go to Rooms</button>
                <button class="btn ghost" @onclick="@(() => Nav.NavigateTo("/home"))">Back to Home</button>
            </div>
        </section>
    }
    else
    {
        var b = BookingState.Bookings[0];  // newest booking (we insert newest first)

        <!-- success banner -->
        <section class="confirm-banner">
            <div class="confirm-icon">✔</div>
            <div>
                <div class="confirm-banner-title">Booking Confirmed!</div>
                <div class="confirm-banner-text">
                    Your reservation was created successfully.
                </div>
            </div>
        </section>

        <!-- reservation summary -->
        <section class="card-block confirm-details">
            <div class="confirm-details-header">
                <div>
                    <h4>Reservation Details</h4>
                    <p>Basic booking information</p>
                </div>
                <span class="status-pill">Confirmed</span>
            </div>

            <div class="confirm-details-body">

                <div class="confirm-grid-2">
                    <div class="confirm-info-block">
                        <div class="label">Room</div>
                        <div class="value">@FormatType(b.RoomType)</div>
                        <div class="sub">Room @b.RoomId</div>
                    </div>

                    <div class="confirm-info-block">
                        <div class="label">Guests</div>
                        <div class="value">@((b.Guests.HasValue) ? b.Guests.Value.ToString() : "N/A")</div>
                        <div class="sub">Including the primary guest</div>
                    </div>

                    <div class="confirm-info-block">
                        <div class="label">Check-in</div>
                        <div class="value">@b.CheckIn.ToString("MMMM d, yyyy")</div>
                        <div class="sub">After 3:00 PM</div>
                    </div>

                    <div class="confirm-info-block">
                        <div class="label">Check-out</div>
                        <div class="value">@b.CheckOut.ToString("MMMM d, yyyy")</div>
                        <div class="sub">Before 11:00 AM</div>
                    </div>
                </div>

                <hr />

                <div class="confirm-section">
                    <h5>Guest Information</h5>
                    <div class="confirm-grid-2">
                        <div class="confirm-info-block">
                            <div class="label">Name</div>
                            <div class="value">@(!string.IsNullOrWhiteSpace(b.FullName) ? b.FullName : "N/A")</div>
                        </div>

                        <div class="confirm-info-block">
                            <div class="label">Email</div>
                            <div class="value">@(!string.IsNullOrWhiteSpace(b.Email) ? b.Email : "N/A")</div>
                        </div>

                        <div class="confirm-info-block">
                            <div class="label">Phone</div>
                            <div class="value">@(!string.IsNullOrWhiteSpace(b.PhoneNumber) ? b.PhoneNumber : "N/A")</div>
                        </div>
                    </div>
                </div>

                <div class="confirm-section">
                    <h5>Total Amount</h5>
                    <div class="confirm-summary-lines">
                        <div class="summary-total" style="border-top:none; padding-top:0; margin-top:0;">
                            <span>Total</span>
                            <span>$@b.TotalAmount.ToString("0.00")</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- bottom actions (simple) -->
        <section class="confirm-actions">
            <div class="confirm-actions-bottom" style="display:flex; gap:.75rem; flex-wrap:wrap;">
                <button class="btn ghost" @onclick="@(() => Nav.NavigateTo("/my-bookings"))">
                    View My Bookings
                </button>
                <button class="btn ghost" @onclick="@(() => Nav.NavigateTo("/rooms"))">
                    Back to Rooms
                </button>
                <button class="btn ghost" @onclick="@(() => Nav.NavigateTo("/home"))">
                    Back to Home
                </button>
            </div>

            <div class="confirm-footer-text">
                Thank you for booking with Grand Hotel.
            </div>
        </section>
    }
</div>

@code {
    private static string FormatType(string? type)
        => string.IsNullOrWhiteSpace(type)
            ? "Room"
            : char.ToUpper(type[0]) + type[1..].ToLower();
}
