@page "/staff/login"
@model HotelManagementSystem.Pages.staff.StaffLoginModel
@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow p-5 rounded-4" style="max-width: 420px; width: 100%;">
        <div class="text-center mb-4">
            <h4 class="fw-bold mb-1">Grand Hotel</h4>
            <p class="text-muted mb-0">Management System</p>
        </div>

        <h5 class="text-center mb-3">Welcome Back</h5>
        <p class="text-center text-secondary mb-4">Sign in to your account to continue</p>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-dark w-100">Sign In →</button>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3 text-center">@Model.ErrorMessage</div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
