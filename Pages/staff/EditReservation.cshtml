@page "/staff/edit-reservation"
@model HotelManagementSystem.Pages.staff.EditReservationModel
@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow p-5 rounded-4" style="max-width: 500px; width: 100%;">
        <h4 class="fw-bold text-center mb-4">Edit Reservation</h4>

        <form method="post">
            <input type="hidden" asp-for="Reservation.Id" />

            <div class="form-group mb-3">
                <label asp-for="Reservation.FullName" class="form-label">Guest Name</label>
                <input asp-for="Reservation.FullName" class="form-control" />
                <span asp-validation-for="Reservation.FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reservation.Email" class="form-label">Email</label>
                <input asp-for="Reservation.Email" type="email" class="form-control" />
                <span asp-validation-for="Reservation.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reservation.PhoneNumber" class="form-label">Phone</label>
                <input asp-for="Reservation.PhoneNumber" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reservation.RoomType" class="form-label">Room Type</label>
                <select asp-for="Reservation.RoomType" class="form-select">
                    <option>Single</option>
                    <option>Double</option>
                    <option>Suite</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reservation.CheckInDate" class="form-label">Check-In Date</label>
                <input asp-for="Reservation.CheckInDate" type="date" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reservation.CheckOutDate" class="form-label">Check-Out Date</label>
                <input asp-for="Reservation.CheckOutDate" type="date" class="form-control" />
            </div>

            <div class="form-group mb-4">
                <label asp-for="Reservation.NumberOfGuests" class="form-label">Guests</label>
                <input asp-for="Reservation.NumberOfGuests" type="number" class="form-control" />
            </div>

            <button type="submit" class="btn btn-dark w-100">Save Changes</button>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-info mt-3 text-center">@Model.Message</div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
