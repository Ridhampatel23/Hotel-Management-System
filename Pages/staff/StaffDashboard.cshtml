@page
@model HotelManagementSystem.Pages.staff.StaffDashboardModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<h1>Staff Dashboard</h1>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Available Rooms</h5>
                <p class="card-text">@Model.AvailableRooms</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">Occupied Rooms</h5>
                <p class="card-text">@Model.OccupiedRooms</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Reservations</h5>
                <p class="card-text">@Model.TotalReservations</p>
            </div>
        </div>
    </div>
</div>

<h2>Rooms</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Room ID</th>
            <th>Type</th>
            <th>Price</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var room in Model.Rooms)
        {
            <tr>
                <td>@room.RoomId</td>
                <td>@room.RoomType</td>
                <td>@room.Price</td>
                <td>@room.Status</td>
            </tr>
        }
    </tbody>
</table>

<h2>Reservations</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Reservation ID</th>
            <th>User ID</th>
            <th>Room ID</th>
            <th>Check-In</th>
            <th>Check-Out</th>
            <th>Total Amount</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var res in Model.Reservations)
        {
            <tr>
                <td>@res.ReservationId</td>
                <td>@res.UserId</td>
                <td>@res.RoomId</td>
                <td>@res.CheckInDate.Substring(0,10)</td>
                <td>@res.CheckOutDate.Substring(0,10)</td>
                <td>@res.TotalAmount</td>
                <td>@res.Status</td>
            </tr>
        }
    </tbody>
</table>

<h2>Users</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Name</th>
            <th>Role</th>
            <th>Email</th>
            <th>Phone</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.UserId</td>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Role</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
            </tr>
        }
    </tbody>
</table>
