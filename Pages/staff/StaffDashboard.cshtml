@page "/staff/dashboard"
@model HotelManagementSystem.Pages.staff.StaffDashboardModel

@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-5">
    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link active" href="#">Dashboard</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">Rooms</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">Reservations</a>
        </li>
    </ul>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4>@Model.HotelName</h4>
            <p class="text-muted mb-0">Management System</p>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-2">Staff View</button>
            <button class="btn btn-outline-primary btn-sm">Switch to Guest View</button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card p-3">
                <h6>Rooms Available</h6>
                <h3>@Model.AvailableRooms</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h6>Rooms Occupied</h6>
                <h3>@Model.OccupiedRooms (@Model.OccupancyRate%)</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h6>Active Reservations</h6>
                <h3>@Model.ActiveReservations</h3>
                <small class="text-muted">@Model.PendingReservations pending</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h6>Revenue (MTD)</h6>
                <h3>$@Model.RevenueMTD</h3>
            </div>
        </div>
    </div>

    <!-- Room Status & Recent Activity -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card p-3">
                <h6>Room Status Overview</h6>
                <ul class="list-unstyled mt-3">
                    <li><span class="badge bg-success me-2">&nbsp;</span>Available: @Model.AvailableRooms rooms</li>
                    <li><span class="badge bg-danger me-2">&nbsp;</span>Occupied: @Model.OccupiedRooms rooms</li>
                    <li><span class="badge bg-warning me-2">&nbsp;</span>Reserved: @Model.ReservedRooms rooms</li>
                    <li><span class="badge bg-secondary me-2">&nbsp;</span>Maintenance: @Model.MaintenanceRooms rooms</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-3">
                <h6>Recent Activity</h6>
                <ul class="list-unstyled mt-3">
                    @if (Model.RecentActivities.Any())
                    {
                        @foreach (var activity in Model.RecentActivities)
                        {
                            <li>
                                <strong>@activity.GuestName</strong> - @activity.Action
                                <br /><small class="text-muted">@activity.TimeAgo</small>
                            </li>
                        }
                    }
                    else
                    {
                        <li>No recent activity</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
