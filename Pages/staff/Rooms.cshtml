@page "/staff/rooms"
@model HotelManagementSystem.Pages.staff.RoomsModel
@{
    ViewData["Title"] = "Room Management";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <h3 class="fw-bold mb-4">Room Management</h3>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <div class="mb-3 text-end">
        <a href="/staff/AddEditRoom" class="btn btn-success">+ Add New Room</a>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Room Number</th>
                <th>Room Type</th>
                <th>Price/Night</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model.Rooms)
            {
                <tr>
                    <td>@room.RoomId</td>
                    <td>@room.RoomType</td>
                    <td>@room.Price.ToString("C")</td>
                    <td>@room.Status</td>
                    <td class="text-center">
                        <a href="/staff/AddEditRoom?id=@room.RoomId" class="btn btn-primary btn-sm">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@room.RoomId" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@room.RoomId" class="d-inline">
                            <button type="submit" class="btn btn-warning btn-sm">
                                @(room.Status == "available" ? "Mark Occupied" : "Mark Available")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
