@page
@model HotelManagementSystem.Pages.staff.ReservationsModel
@{
    ViewData["Title"] = "Reservations";
    Layout = "_Layout";
}

<h3 class="fw-bold mb-4">Reservations</h3>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Reservation #</th>
                <th>User Id</th>
                <th>Room</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reservation in Model.Reservations)
            {
                <tr>
                    <td>@reservation.ReservationId</td>
                    <td>@reservation.UserId</td>
                    <td>@reservation.RoomType (@reservation.RoomId)</td>
                    <td>@reservation.CheckInDate.ToShortDateString()</td>
                    <td>@reservation.CheckOutDate.ToShortDateString()</td>
                    <td>@reservation.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
