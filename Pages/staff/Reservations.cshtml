@page "/staff/reservations"
@model HotelManagementSystem.Pages.staff.ReservationsModel
@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Reservations</h3>
        <a href="/staff/create-reservation" class="btn btn-dark">+ New Reservation</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    @if (Model.Reservations == null || !Model.Reservations.Any())
    {
        <div class="alert alert-secondary text-center">No reservations found.</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Guest</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Room</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Guests</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var res in Model.Reservations)
            {
                <tr>
                    <td>@res.FullName</td>
                    <td>@res.Email</td>
                    <td>@res.PhoneNumber</td>
                    <td>@res.RoomType</td>
                    <td>@res.CheckInDate.ToString("yyyy-MM-dd")</td>
                    <td>@res.CheckOutDate.ToString("yyyy-MM-dd")</td>
                    <td>@res.NumberOfGuests</td>
                    <td>
                        <a href="/staff/edit-reservation?id=@res.Id" class="btn btn-sm btn-outline-primary me-2">Edit</a>
                        <form method="post" asp-page-handler="Delete" class="d-inline">
                            <input type="hidden" name="id" value="@res.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this reservation?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
