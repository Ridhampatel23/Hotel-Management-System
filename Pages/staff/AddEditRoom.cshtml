@page
@model HotelManagementSystem.Pages.staff.AddEditRoomModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Room" : "Add Room";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <h3 class="fw-bold mb-4">@ViewData["Title"]</h3>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Room Number</label>
            <input asp-for="Room.Number" class="form-control" placeholder="Enter room number" />
            <span asp-validation-for="Room.Number" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Room Type</label>
            <input asp-for="Room.Type" class="form-control" placeholder="Enter room type" />
            <span asp-validation-for="Room.Type" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Price Per Night</label>
            <input asp-for="Room.Price" type="number" step="0.01" class="form-control" placeholder="Enter price" />
            <span asp-validation-for="Room.Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select asp-for="Room.Status" class="form-select">
                <option>Available</option>
                <option>Occupied</option>
            </select>
            <span asp-validation-for="Room.Status" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">@ViewData["Title"]</button>
        <a href="/staff/rooms" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
